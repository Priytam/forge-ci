FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags "-X github.com/priytamjeepandey/forge-ci/internal/buildinfo.Version=${VERSION}" -o /out/forge-runner ./cmd/runner

FROM alpine:3
# Jobs run as shell scripts inside this container; git and curl are the
# most common tools a script needs.
RUN apk add --no-cache git curl
RUN adduser -D forge
USER forge
COPY --from=build /out/forge-runner /usr/local/bin/forge-runner
ENTRYPOINT ["forge-runner"]
