FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags "-s -w -X github.com/priytamjeepandey/forge-ci/internal/buildinfo.Version=${VERSION}" -o /out/forge-agent ./cmd/agent

# The agent needs nothing but CA certificates: it talks to the Kubernetes
# API (in-cluster) or Google's APIs, and to Forge.
FROM alpine:3
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 forge
USER 10001
COPY --from=build /out/forge-agent /usr/local/bin/forge-agent
ENTRYPOINT ["forge-agent"]
