FROM golang:1.25-alpine AS build
# VERSION is stamped into the server and the bundled runner binaries
# (internal/buildinfo), so the UI can tell outdated runners.
ARG VERSION=dev
ENV LDFLAGS="-X github.com/priytamjeepandey/forge-ci/internal/buildinfo.Version=${VERSION}"
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -ldflags "$LDFLAGS" -o /out/forge-server ./cmd/server

# Prebuilt forge-runner binaries, served from /api/v1/downloads/ so a QA
# machine can register as a runner with a copy-paste command instead of
# cloning this repo and building Go toolchain locally (see
# deploy/downloads/install-runner.sh, internal/api/downloads.go).
RUN CGO_ENABLED=0 GOOS=darwin  GOARCH=arm64 go build -ldflags "$LDFLAGS" -o /out/downloads/forge-runner-darwin-arm64       ./cmd/runner && \
    CGO_ENABLED=0 GOOS=darwin  GOARCH=amd64 go build -ldflags "$LDFLAGS" -o /out/downloads/forge-runner-darwin-amd64       ./cmd/runner && \
    CGO_ENABLED=0 GOOS=linux   GOARCH=amd64 go build -ldflags "$LDFLAGS" -o /out/downloads/forge-runner-linux-amd64        ./cmd/runner && \
    CGO_ENABLED=0 GOOS=linux   GOARCH=arm64 go build -ldflags "$LDFLAGS" -o /out/downloads/forge-runner-linux-arm64        ./cmd/runner && \
    CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -ldflags "$LDFLAGS" -o /out/downloads/forge-runner-windows-amd64.exe  ./cmd/runner && \
    echo "$VERSION" > /out/downloads/VERSION

FROM alpine:3
# git: the server reads and diffs repos on any git host with plain git, and
# resolves refs with `git ls-remote` (internal/vcs/provider_git.go).
#
# Optional git remote helpers, one build arg per host that needs one. None is
# needed by default: CodeCommit branches resolve through the AWS SDK. Only
# resolving CodeCommit *tags* (codecommit:: URLs) needs git-remote-codecommit:
#   docker build --build-arg WITH_CODECOMMIT_HELPER=true -f deploy/Dockerfile.server .
# It lives in its own venv (Alpine's pip refuses system-wide installs, PEP 668)
# and is linked onto PATH for the non-root forge user.
ARG WITH_CODECOMMIT_HELPER=false
RUN apk add --no-cache git ca-certificates \
 && if [ "$WITH_CODECOMMIT_HELPER" = "true" ]; then \
      apk add --no-cache python3 \
      && python3 -m venv /opt/codecommit-venv \
      && /opt/codecommit-venv/bin/pip install --no-cache-dir git-remote-codecommit==1.17 \
      && ln -s /opt/codecommit-venv/bin/git-remote-codecommit /usr/local/bin/git-remote-codecommit; \
    fi \
 && adduser -D forge
COPY --from=build /out/forge-server /usr/local/bin/forge-server
COPY --from=build /out/downloads /usr/local/share/forge-downloads
COPY deploy/downloads/install-runner.sh deploy/downloads/install-runner.ps1 deploy/downloads/qa-test-template.csv /usr/local/share/forge-downloads/
RUN chown -R forge:forge /usr/local/share/forge-downloads
USER forge
EXPOSE 8080
ENTRYPOINT ["forge-server"]
